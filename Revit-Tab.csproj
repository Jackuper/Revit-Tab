<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release_2021;Release_2022;Release_2023;Release_2024;Release_2025</Configurations>
    <AssemblyName>Jcup</AssemblyName>
    <RootNamespace>Revit_Tab</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <MarkMarkupCompilePass1AsWinFX>true</MarkMarkupCompilePass1AsWinFX>
  </PropertyGroup>

  <!-- Configuration-specific properties for CI/CD builds -->
  <PropertyGroup Condition="$(Configuration.Contains('Release_2021'))">
    <RevitVersion>2021</RevitVersion>
    <OutputPath>bin\Release\2021\</OutputPath>
    <DefineConstants>TRACE;REVIT2021</DefineConstants>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2022'))">
    <RevitVersion>2022</RevitVersion>
    <OutputPath>bin\Release\2022\</OutputPath>
    <DefineConstants>TRACE;REVIT2022</DefineConstants>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2023'))">
    <RevitVersion>2023</RevitVersion>
    <OutputPath>bin\Release\2023\</OutputPath>
    <DefineConstants>TRACE;REVIT2023</DefineConstants>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2024'))">
    <RevitVersion>2024</RevitVersion>
    <OutputPath>bin\Release\2024\</OutputPath>
    <DefineConstants>TRACE;REVIT2024</DefineConstants>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2025'))">
    <RevitVersion>2025</RevitVersion>
    <OutputPath>bin\Release\2025\</OutputPath>
    <DefineConstants>TRACE;REVIT2025</DefineConstants>
    <TargetFramework>net8.0-windows</TargetFramework>
  </PropertyGroup>

  <!-- Default Debug configuration -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <RevitVersion>2023</RevitVersion>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;REVIT2023</DefineConstants>
    <TargetFramework>net48</TargetFramework>
  </PropertyGroup>

  <!-- NuGet References for CI/CD Cloud Building -->
  <ItemGroup Condition="$(Configuration.Contains('Release_'))">
    <!-- Dynamic Package Versioning for GitHub Actions -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitVersion).*" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitVersion).*" />
  </ItemGroup>

  <!-- NuGet References for Local Development -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Revit_All_Main_Versions_API_x64" Version="2023.*" />
  </ItemGroup>

  <!-- Common dependencies -->
  <ItemGroup>
    <PackageReference Include="Aspose.Cells" Version="25.10.0" />
  </ItemGroup>

  <!-- Include addon file and resources -->
  <ItemGroup>
    <None Remove="Utility\MyCustomTab.addin" />
    <Content Include="Utility\MyCustomTab.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Families\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <EmbeddedResource Include="Images\**" />
  </ItemGroup>

  <!-- Auto-deploy to Revit addins folder during local development -->
  <Target Name="CopyFilesToRevitAddins" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <ItemGroup>
      <RevitVersionToDeploy Include="2023" Condition="'$(TargetFramework)' == 'net48'" />
      <RevitVersionToDeploy Include="2024" Condition="'$(TargetFramework)' == 'net48'" />
      <RevitVersionToDeploy Include="2025" Condition="'$(TargetFramework)' == 'net8.0-windows'" />
    </ItemGroup>

    <PropertyGroup>
      <RevitAddinsPath>$(AppData)\Autodesk\Revit\Addins\%(RevitVersionToDeploy.Identity)</RevitAddinsPath>
      <AddinBundlePath>$(RevitAddinsPath)\$(AssemblyName)</AddinBundlePath>
    </PropertyGroup>

    <Message Text="Deploying $(TargetFramework) build to Revit %(RevitVersionToDeploy.Identity)..." Importance="high" />

    <MakeDir Directories="$(AddinBundlePath)" />
    <ItemGroup>
      <SourceFiles Include="$(TargetDir)**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(SourceFiles)" DestinationFolder="$(AddinBundlePath)\%(RecursiveDir)" />
    <Copy SourceFiles="$(ProjectDir)Utility\MyCustomTab.addin" DestinationFolder="$(RevitAddinsPath)" />
  </Target>
</Project>
