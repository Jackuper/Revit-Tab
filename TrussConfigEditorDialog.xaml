<Window x:Class="Revit_Tab.TrussConfigEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Review Extracted Truss Types"
        Width="820" Height="480"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="12">

        <!-- Default family name -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Default Structural Framing Family:" VerticalAlignment="Center"
                       Margin="0,0,8,0" FontWeight="Bold"/>
            <TextBox x:Name="TxtDefaultFamily"
                     Text="Wood Timber-Lumber"
                     Width="220" VerticalAlignment="Center"/>
            <TextBlock Text="(applies to all chord and web members)"
                       VerticalAlignment="Center" Foreground="Gray" Margin="8,0,0,0"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatus" VerticalAlignment="Center"
                       Foreground="Gray" Margin="0,0,16,0"/>
            <Button Content="Save to trusses.json" Width="150" Margin="0,0,8,0"
                    Click="Save_Click"/>
            <Button Content="Cancel" Width="72" Click="Cancel_Click"/>
        </StackPanel>

        <!-- Data grid -->
        <DataGrid x:Name="GridTrusses"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  RowHeaderWidth="0"
                  GridLinesVisibility="All"
                  AlternatingRowBackground="#F5F5F5"
                  Margin="0,0,0,0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Type"         Binding="{Binding TypeKey}"          Width="70"/>
                <DataGridTextColumn Header="Depth (in)"   Binding="{Binding DepthInches}"       Width="80"/>
                <DataGridTextColumn Header="Top Chord"    Binding="{Binding TopChordSize}"      Width="90"/>
                <DataGridTextColumn Header="Bot Chord"    Binding="{Binding BotChordSize}"      Width="90"/>
                <DataGridTextColumn Header="Webs"         Binding="{Binding WebSize}"           Width="70"/>
                <DataGridTextColumn Header="Spacing (in)" Binding="{Binding WebSpacingInches}"  Width="90"/>
                <DataGridTextColumn Header="Pattern"      Binding="{Binding WebPattern}"        Width="80"/>
                <DataGridTextColumn Header="Family"       Binding="{Binding FamilyName}"        Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
