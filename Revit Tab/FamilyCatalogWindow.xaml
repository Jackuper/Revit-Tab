<Window x:Class="Revit_Tab.FamilyCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Family Catalog" Height="600" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ListView showing catalog items with a checkbox -->
        <ListView x:Name="lvFamilies" SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="1" BorderBrush="LightGray" Padding="4" Margin="2">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="chkSelect" VerticalAlignment="Center"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            <Image Width="64" Height="64" Margin="5"
                     Source="{Binding Thumbnail}"
                     Stretch="Uniform"/>
                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FamilyName}" FontWeight="Bold" FontSize="14"/>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Button to import selected families -->
        <Button Grid.Row="1" Content="Import Selected Families" Margin="5" 
            HorizontalAlignment="Right" Width="200"
            Click="btnImport_Click"/>
    </Grid>
</Window>
