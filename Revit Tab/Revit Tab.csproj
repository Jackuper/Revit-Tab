<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release_2021;Release_2022;Release_2023;Release_2024;Release_2025</Configurations>
    <AssemblyName>Jcup</AssemblyName>
    <RootNamespace>Revit_Tab</RootNamespace>
    <!-- GenerateAssemblyInfo needs to be false if you have a Properties/AssemblyInfo.cs file, 
         otherwise delete AssemblyInfo.cs and let the SDK generate it. 
         I'll assume we want to use the existing one for now, so we set this to false. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Fix for MC1000 error with .NET 4.8 WPF projects on newer SDKs -->
    <MarkMarkupCompilePass1AsWinFX>true</MarkMarkupCompilePass1AsWinFX>
  </PropertyGroup>

  <!-- Configuration-specific properties -->
  <PropertyGroup Condition="$(Configuration.Contains('Release_2021'))">
    <RevitVersion>2021</RevitVersion>
    <OutputPath>bin\Release\2021\</OutputPath>
    <DefineConstants>TRACE;REVIT2021</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2022'))">
    <RevitVersion>2022</RevitVersion>
    <OutputPath>bin\Release\2022\</OutputPath>
    <DefineConstants>TRACE;REVIT2022</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2023'))">
    <RevitVersion>2023</RevitVersion>
    <OutputPath>bin\Release\2023\</OutputPath>
    <DefineConstants>TRACE;REVIT2023</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2024'))">
    <RevitVersion>2024</RevitVersion>
    <OutputPath>bin\Release\2024\</OutputPath>
    <DefineConstants>TRACE;REVIT2024</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="$(Configuration.Contains('Release_2025'))">
    <RevitVersion>2025</RevitVersion>
    <OutputPath>bin\Release\2025\</OutputPath>
    <DefineConstants>TRACE;REVIT2025</DefineConstants>
  </PropertyGroup>
  
  <!-- Default Debug -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <RevitVersion>2023</RevitVersion>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE;REVIT2023</DefineConstants>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <!-- Revit API References -->
    <Reference Include="RevitAPI">
      <HintPath>$(ProgramData)\Autodesk\Revit\$(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI">
      <HintPath>$(ProgramData)\Autodesk\Revit\$(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- Fallbacks -->
    <Reference Include="RevitAPI" Condition="!Exists('$(ProgramData)\Autodesk\Revit\$(RevitVersion)\RevitAPI.dll')">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="RevitAPIUI" Condition="!Exists('$(ProgramData)\Autodesk\Revit\$(RevitVersion)\RevitAPIUI.dll')">
      <HintPath>C:\Program Files\Autodesk\Revit $(RevitVersion)\RevitAPIUI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    
    <!-- Dependencies from remote -->
    <PackageReference Include="Aspose.Cells" Version="25.10.0" />
  </ItemGroup>
  
  <ItemGroup>
    <None Update="Utility\MyCustomTab.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>