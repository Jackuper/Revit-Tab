<Window x:Class="Revit_Tab.TrussImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Trusses from DWG"
        Width="480" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="16">

        <!-- DWG File -->
        <TextBlock Text="DWG File" FontWeight="Bold" Margin="0,0,0,4"/>
        <DockPanel Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Browse..." Width="72"
                    Click="BrowseDwg_Click"/>
            <TextBox x:Name="TxtDwgPath" IsReadOnly="True" Margin="0,0,8,0"
                     Text="(no file selected)" Foreground="Gray"/>
        </DockPanel>

        <!-- DWG Units -->
        <TextBlock Text="DWG Units" FontWeight="Bold" Margin="0,0,0,4"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <RadioButton x:Name="RbInches" Content="Inches" IsChecked="True" Margin="0,0,16,0"/>
            <RadioButton x:Name="RbFeet"   Content="Feet"/>
        </StackPanel>

        <!-- Level -->
        <TextBlock Text="Revit Level" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox x:Name="CboLevel" Margin="0,0,0,12"/>

        <!-- Base Elevation -->
        <TextBlock Text="Base Elevation (inches above level)" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBox x:Name="TxtBaseElev" Text="0" Margin="0,0,0,12"/>

        <!-- Truss Type Override -->
        <TextBlock Text="Truss Type (override auto-detect)" FontWeight="Bold" Margin="0,0,0,4"/>
        <ComboBox x:Name="CboTrussType" Margin="0,0,0,12"/>

        <!-- Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,8">
            <Button x:Name="BtnParse"  Content="Parse DWG"     Width="100" Margin="0,0,8,0"
                    Click="ParseDwg_Click"/>
            <Button x:Name="BtnPlace"  Content="Place Trusses" Width="110" Margin="0,0,8,0"
                    Click="PlaceTrusses_Click" IsEnabled="False"/>
            <Button Content="Cancel"                            Width="72"
                    Click="Cancel_Click"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock x:Name="TxtStatus" Text="Select a DWG file to begin."
                   TextWrapping="Wrap" Foreground="Gray" Margin="0,4,0,0"/>

    </StackPanel>
</Window>
